rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'mdmasum372asa@gmail.com' || request.auth.token.email == 'lxm88821@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 250 &&
             data.category is string && data.category.size() <= 100 &&
             data.regularPrice is number && data.regularPrice >= 0;
    }

    function isValidOrder(data) {
      return data.orderId is string && data.orderId.size() >= 3 && data.orderId.size() <= 64 &&
             data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 150 &&
             data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 20 &&
             data.address is string && data.address.size() >= 4 && data.address.size() <= 500 &&
             (data.deliveryLocation == 'inside_cox' || data.deliveryLocation == 'outside_cox') &&
             (data.paymentMethod == 'bkash' || data.paymentMethod == 'nagad') &&
             data.transactionId is string && data.transactionId.size() >= 4 && data.transactionId.size() <= 64 &&
             data.deliveryCharge is number && data.deliveryCharge >= 0 &&
             data.productTotal is number && data.productTotal >= 0 &&
             data.grandTotal is number && data.grandTotal >= 0 &&
             data.products is list && data.products.size() > 0 && data.products.size() <= 50;
    }

    // Products collection
    match /products/{productId} {
      allow get: if isValidId(productId) && (
        resource.data.isPublished == true || 
        resource.data.published == true || 
        isAdmin()
      );
      allow list: if (
        resource.data.isPublished == true || 
        resource.data.published == true || 
        isAdmin()
      );
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update: if isValidId(categoryId) && isAdmin() &&
                            incoming().name is string && incoming().name.size() <= 100;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if isAdmin();
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && isAdmin();
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Banners collection
    match /banners/{bannerId} {
      allow get: if isValidId(bannerId);
      allow list: if true;
      allow create, update: if isValidId(bannerId) && isAdmin() &&
                            incoming().title is string && incoming().title.size() <= 200;
      allow delete: if isValidId(bannerId) && isAdmin();
    }

    // Website & Payment settings collection
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if isValidId(settingId) && isAdmin();
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSignedIn() && (
        request.auth.uid == adminId && (
          request.auth.token.email == 'mdmasum372asa@gmail.com' ||
          request.auth.token.email == 'lxm88821@gmail.com'
        )
      );
    }
  }
}
